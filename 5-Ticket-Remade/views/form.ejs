<h1>Ticket Form</h1>
<a href="/">Quay lại</a>

<form action="/tickets/upsert<%= ticket ? `/${ticket.ticketId}` : "" %>" method="POST" enctype="multipart/form-data">
    <div style="display: flex; flex-direction: column; gap: 1rem; margin: 1rem auto;">
        <input type="text" name="eventName" placeholder="eventName" value="<%= ticket?.eventName %>">
        <input type="text" name="holderName" placeholder="holderName" value="<%= ticket?.holderName %>">

        <div>
            <label>Category</label>
            <select name="category">
                <option value="Standard" <%= ticket?.category === "Standard" ? "selected" : "" %>>Standard</option>
                <option value="VIP" <%= ticket?.category === "VIP" ? "selected" : "" %>>VIP</option>
                <option value="VVIP" <%= ticket?.category === "VVIP" ? "selected" : "" %>>VVIP</option>
            </select>
        </div>

        <input type="number" name="quantity" placeholder="quantity" value="<%= ticket?.quantity %>">
        <input type="number" name="pricePerTicket" placeholder="pricePerTicket" value="<%= ticket?.pricePerTicket %>">
        <input type="date" name="eventDate" placeholder="eventDate" value="<%= ticket?.eventDate %>">

        <div>
            <label>Status</label>
            <select name="status">
                <option value="Upcoming" <%= ticket?.status === "Upcomming" ? "selected" : "" %>>Upcoming</option>
                <option value="Sold" <%= ticket?.status === "Sold" ? "selected" : "" %>>Upcoming</option>
                <option value="Cancelled" <%= ticket?.status === "Cancelled" ? "selected" : "" %>>Upcoming</option>
            </select>
        </div>

        <input type="file" name="image">

        <button type="submit">Xác nhận</button>

    </div>
</form>

<% if (typeof error !== "undefined" && error) { %>
    <p><%= error %></p>
<% } %>