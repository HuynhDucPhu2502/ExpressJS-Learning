<h1>Biểu mẫu lịch hẹn</h1>
<a href="/appointments">Quay lại</a>

<form
  action="/appointments/upsert<%= appointment ? `/${appointment.appointmentId}` : "" %>"
  method="post"
  enctype="multipart/form-data"
>
    <div style="display: flex; flex-direction: column; gap: 1rem; margin: 1rem auto;">

        <div>
            <label>patientName</label>
            <input type="text" name="patientName" value="<%= appointment?.patientName %>" required>
        </div>

        <div>
            <label>doctorName</label>
            <input type="text" name="doctorName" value="<%= appointment?.doctorName %>" required>
        </div>

        <div>
            <label>specialty</label>
            <input type="text" name="specialty" value="<%= appointment?.specialty %>">
        </div>

        <div>
            <label>appointmentDate</label>
            <input type="date" name="appointmentDate" value="<%= appointment?.appointmentDate %>">
        </div>
        
        <div>
            <label>fee</label>
            <input type="number" name="fee" value="<%= appointment?.fee %>">
        </div>

        <div>
            <label>status</label>
            <select name="status">
                <option value="Pending" <%= appointment?.status === "Pending" ? "selected" : "" %>>Pending</option>
                <option value="Confirmed" <%= appointment?.status === "Confirmed" ? "selected" : "" %>>Confirmed</option>
                <option value="Done" <%= appointment?.status === "Done" ? "selected" : "" %>>Done</option>
                <option value="Cancelled" <%= appointment?.status === "Cancelled" ? "selected" : "" %>>Cancelled</option>
            </select>
        </div>

        <div>
            <label>noteImageUrl</label>
            <input type="file" name="image">
        </div>

        <button type="submit">Save</button>

    </div>
</form>

<% if (typeof error !== "undefined" && error) { %>
    <p><%= error %></p>
<% } %>